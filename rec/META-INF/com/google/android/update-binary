#!/sbin/sh

OUTFD=$2
ZIPFILE=$3
TMP=/tmp/poafix

ui_print() {
    echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

abort() {
    ui_print " "
    ui_print "!! ERROR: $1"
    ui_print " "
    exit 1
}

ui_print "=========================================="
ui_print " PowerOffAlarm Recovery Flasher"
ui_print " For whyred / CRDroid 7.1"
ui_print "=========================================="

ui_print "- Remounting partitions rw..."
mount -o rw,remount / 2>/dev/null
mount -o rw,remount /vendor 2>/dev/null
mount -o rw,remount /system 2>/dev/null

if [ ! -w /vendor/bin ] 2>/dev/null; then
    mount /vendor 2>/dev/null
    mount -o rw,remount /vendor 2>/dev/null
fi

mkdir -p $TMP

ui_print "- Extracting files from ZIP..."
unzip -o "$ZIPFILE" power_off_alarm -d $TMP >/dev/null 2>&1
[ -f $TMP/power_off_alarm ] || abort "power_off_alarm not found in ZIP"

ui_print "- Installing /vendor/bin/power_off_alarm..."
cp -f $TMP/power_off_alarm /vendor/bin/power_off_alarm || abort "copy power_off_alarm failed"
chmod 755 /vendor/bin/power_off_alarm
chcon u:object_r:power_off_alarm_exec:s0 /vendor/bin/power_off_alarm 2>/dev/null

INIT_RC=/vendor/etc/init/hw/init.qcom.rc
[ -f "$INIT_RC" ] || abort "init.qcom.rc not found: $INIT_RC"

ui_print "- Patching init.qcom.rc..."

if [ ! -f "${INIT_RC}.bak" ]; then
    cp -f "$INIT_RC" "${INIT_RC}.bak"
    ui_print "  backup created: ${INIT_RC}.bak"
fi

# Get services
if ! grep -q "^service vendor.power_off_alarm " "$INIT_RC"; then
    echo "" >> "$INIT_RC"
    echo "service vendor.power_off_alarm /vendor/bin/power_off_alarm" >> "$INIT_RC"
    echo "    class core" >> "$INIT_RC"
    echo "    group system" >> "$INIT_RC"
    echo "    disabled" >> "$INIT_RC"
    echo "    oneshot" >> "$INIT_RC"
    ui_print "  appended: service vendor.power_off_alarm"
else
    ui_print "  service already present, skipped"
fi

# Ensure on init trigger is exist
if ! grep -q "start vendor.power_off_alarm" "$INIT_RC"; then
    echo "" >> "$INIT_RC"
    echo "on init" >> "$INIT_RC"
    echo "    start vendor.power_off_alarm" >> "$INIT_RC"
    ui_print "  appended: on init start vendor.power_off_alarm"
else
    ui_print "  on init trigger already present, skipped"
fi

chmod 644 "$INIT_RC"
chcon u:object_r:vendor_configs_file:s0 "$INIT_RC" 2>/dev/null

ui_print "- Verifying..."
ls -lZ /vendor/bin/power_off_alarm 2>/dev/null || true
grep -n "power_off_alarm" "$INIT_RC" 2>/dev/null || true

rm -rf $TMP

ui_print "=========================================="
ui_print " Done. Reboot device to apply."
ui_print "=========================================="

exit 0